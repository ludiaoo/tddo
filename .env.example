# 高德地图 API 配置模板
# 用法：复制成 .env 再填值。.env 已被 .gitignore 忽略，不会被提交。
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# 申请入口：https://console.amap.com/dev/key/app

# Web 服务 Key（服务端调用：v3/distance 距离矩阵、v3/staticmap 静态图）
AMAP_KEY=

# Web端(JS API) Key（浏览器里加载地图 SDK；与上面那个不是同一个平台，不能互换）
AMAP_JS_KEY=

# JS API 安全密钥（2.0 版必填，与 AMAP_JS_KEY 成对使用）
AMAP_JS_SECRET=
